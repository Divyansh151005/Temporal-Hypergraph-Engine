{
  "name": "@hypergraph/sdk",
  "version": "0.1.0",
  "description": "TypeScript client and Vercel AI SDK memory for the Temporal Hypergraph Engine",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ai": {
      "import": {
        "types": "./dist/ai-sdk.d.ts",
        "default": "./dist/ai-sdk.js"
      },
      "require": {
        "types": "./dist/ai-sdk.d.cts",
        "default": "./dist/ai-sdk.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen": "../../scripts/gen_protos.sh ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.2",
    "@grpc/grpc-js": "^1.14.0"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ai": "^7.0.0",
    "ts-proto": "^2.18.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0",
    "zod": "^4.1.8"
  }
}
