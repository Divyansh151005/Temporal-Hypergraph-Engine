# Copy to .env (git-ignored), fill in, then load with: set -a; source .env; set +a
# Providers without a key are skipped in every chain.

# xAI Grok (keys start with xai-)
XAI_API_KEY=
# Groq inference (keys start with gsk_)
GROQ_API_KEY=
# Any other OpenAI-compatible server (OpenAI, Ollama, vLLM)
LLM_API_KEY=
LLM_BASE_URL=

# Optional per-role provider chains (comma-separated provider:model, tried in order)
# GENERATOR_LLM=xai:grok-4.7,groq:qwen/qwen3.8-27b
# EXTRACT_LLM=xai:grok-4.7,groq:qwen/qwen3.8-27b
# ANSWER_LLM=groq:qwen/qwen3.8-27b,xai:grok-4.7
# JUDGE_LLM=groq:qwen/qwen3.8-27b,xai:grok-4.7

# Force one provider for every role (optional)
# LLM_PROVIDER=
# LLM_MODEL=

# Response cache ("" disables)
# LLM_CACHE_DIR=.cache/llm
